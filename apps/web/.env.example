# Plantilla de variables de entorno para apps/web.
# Copiar a .env.local y ajustar. NUNCA commitear .env.local con valores reales.

# URL del backend NestJS. Solo se usa en desarrollo local.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Origen público del sitio. Lo usa Next para resolver las URLs absolutas de
# Open Graph / Twitter Card (metadataBase). Sin esto, las imagenes de sharing
# salen con http://localhost:3000 y no se ven al compartir en redes.
NEXT_PUBLIC_SITE_URL=https://glassworldstudio.com