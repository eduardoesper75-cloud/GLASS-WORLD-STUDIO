{
  "name": "@gws/pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Pipeline de automatización de GWS: ingesta (Google Drive/Docs, YouTube), formateo y validación de Fichas de Curaduría.",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:cards": "tsx src/index.ts validate-cards",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@gws/schemas": "workspace:*",
    "@gws/taxonomy": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
