# =====================================================================
# Glass World Studio (GWS) — Variables de entorno de referencia
# Copia este archivo a `.env` y completa los valores. NUNCA versiones `.env`.
# =====================================================================

# --- Runtime ---
NODE_ENV=development

# --- Google Cloud / Drive & Docs REST API ---
# Carpeta raíz de la base de conocimiento curada.
GOOGLE_DRIVE_FOLDER_ID=
# Opción A: cuenta de servicio (recomendado para automatización headless).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Opción B: ruta al JSON de credenciales (tiene prioridad si está definida).
GOOGLE_APPLICATION_CREDENTIALS=

# --- Capa de presentación (cliente web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# --- Limpieza de correo (IMAP / imap-mcp-server) ---
# Casillas oficiales de GWS. Las claves son CONTRASEÑAS DE APLICACIÓN de
# Google (requieren verificación en dos pasos). NUNCA se versionan: van en
# `.env` o `.env.local`. Ver `tools/imap-mcp/README.md`.
# Se consumen por: tools/imap-mcp/launch.mjs (MCP) y @gws/mail-cleanup (CLI).
IMAP_MCP_ACCOUNT_EDUARDOESPER75_IMAP_USERNAME=eduardoesper75@gmail.com
IMAP_MCP_ACCOUNT_EDUARDOESPER75_IMAP_PASSWORD=
# La casilla institucional (edu.esper@glassworldstudio.com.ar) NO es de Gmail:
# su SMTP/IMAP se configura con el proveedor del dominio (Don Web), no con
# contraseñas de aplicación de Google. Ver docs/outreach/GWS_Checklist_Salida_Operativa.md.
# Guardrails del servidor MCP (por defecto, solo lectura).
IMAP_MCP_READ_ONLY=true
# Nota TLS: con antivirus/proxy que inspecciona TLS (p. ej. Avast Mail Shield),
# el CLI y el launcher MCP usan `--use-system-ca` (Node >= 22.15) para confiar
# en el CA raíz del sistema. Ver tools/imap-mcp/README.md.
# Opcional: .env adicional de menor prioridad.
# GWS_IMAP_ENV_FILE=
