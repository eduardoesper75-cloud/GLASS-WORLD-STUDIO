# GWS Backend — variables de entorno (copia este archivo a .env y completá)
# NUNCA subas el .env real ni valores reales al repositorio.

# Puerto HTTP del backend
PORT=3001

# Origen permitido para CORS (frontend). En producción: dominio real del front.
CORS_ORIGIN=http://localhost:3000

# Secreto de firma de JWT — generar con: openssl rand -base64 48
JWT_SECRET=REEMPLAZAR_POR_VALOR_ALEATORIO_SEGURO

# Conexión PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=gws_dev
DB_PASSWORD=gws_dev_password_local_only
DB_NAME=gws_dev

# development | production
NODE_ENV=development

# Rate limiting global (anti-DoS) — ventana y límite por IP
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT_PER_MINUTE=100

# Barrera de membresía fundadora (GalaxyAccessGuard). Por defecto APAGADA:
# la fundación no bloquea a nadie hasta activarla explícitamente.
# true  = al agotarse los cupos de una Galaxia, el acceso exige cupo de
#         fundación (o rol admin). false = sin barrera.
FOUNDATION_GATES_ENABLED=false

# Galaxias reservadas (g4/g5, CLAUDE.md §1): siempre exigen cupo o admin,
# aun con cupos disponibles. false = tratarlas como galaxias normales.
FOUNDATION_GATES_RESERVED=true


# Thread pool de libuv (B15). bcrypt es CPU-bound y compite con el event loop;
# con el default de 4 threads el pool se satura y las lecturas se ralentizan. Medido:
# subir a 8 reduce el tiempo total a la mitad con concurrencia de login.
# 8 threads se recalibro para 8 vCPU; con menos cores, 4 tambien sirve.
# Si no se define, src/config/threadpool.ts aplica 8. Se acota a 16.
# Docs: docs/ops/investigacion-b15-picos.md
UV_THREADPOOL_SIZE=8